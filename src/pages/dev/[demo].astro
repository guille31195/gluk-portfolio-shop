---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WallLabel from '../../components/WallLabel.astro';
import type { Artwork } from '../../lib/artwork-map';
import type { PrintOffer } from '../../lib/prints/offer';

// Dev-only visual check: never emitted by a build.
export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { demo: 'print-block' } }] : [];
}

// Fixture prices, not real ones.
const offers: PrintOffer[] = [
  { format: 'large', size: { widthCm: 80, heightCm: 100 }, sizeLabel: '80 × 100 cm', priceCents: 90000 },
  { format: 'small', size: { widthCm: 40, heightCm: 50 }, sizeLabel: '40 × 50 cm', priceCents: 40000 },
];
// ?original=sold|auction switches the Original block.
const status = Astro.url.searchParams.get('original');
const artwork: Artwork = {
  slug: 'motopirueta-fixture',
  title: 'Motopirueta fixture',
  medium: 'oil-painting',
  materials: null,
  year: null,
  dimensions: '120 × 150 cm',
  description: null,
  images: [],
  originalStatus: status === 'sold' ? 'sold' : status === 'auction' ? 'auction' : 'available',
  auctionUrl: 'https://example.test/lot',
  printOffers: offers,
  series: null,
  seriesPosition: null,
  haloSetting: 'auto',
  halo: false,
};
---
<BaseLayout title="Print block fixture">
  <section class="page demo">
    <WallLabel artwork={artwork} heading="Fixture · test prices, not real" siblings={[]} />
  </section>
</BaseLayout>

<script is:inline>
  // ?stock=37,4 | ?stock=0,0 | ?stock=fail | ?checkout=sold-out|busy|server
  (function () {
    var params = new URLSearchParams(location.search);
    var real = window.fetch.bind(window);
    window.fetch = function (url, init) {
      var u = String(url);
      if (u.indexOf('/api/stock') === 0) {
        var s = params.get('stock') || '37,4';
        if (s === 'fail') return Promise.reject(new Error('stock fixture'));
        var p = s.split(',');
        return Promise.resolve(new Response(JSON.stringify({ large: Number(p[0]), small: Number(p[1]) }), { status: 200 }));
      }
      if (u.indexOf('/api/checkout') === 0) {
        var c = params.get('checkout') || 'server';
        var status = c === 'sold-out' ? 409 : c === 'busy' ? 503 : 500;
        return Promise.resolve(new Response(JSON.stringify({ error: c }), { status: status }));
      }
      return real(url, init);
    };
  })();
</script>

<style>
  .demo {
    max-width: 38rem;
  }
  .wall-label {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }
  :global([data-intro]) {
    visibility: visible !important;
    opacity: 1 !important;
    transform: none !important;
  }
  :global(.demo-rule) {
    width: 9rem !important;
  }
</style>

<script is:inline>
  // ?country=ES preselects a destination so that state can be screenshotted.
  document.addEventListener('astro:page-load', function () {
    var code = new URLSearchParams(location.search).get('country');
    var select = document.querySelector('[data-country]');
    if (!code || !select) return;
    setTimeout(function () {
      select.value = code;
      select.dispatchEvent(new Event('change', { bubbles: true }));
    }, 300);
  });
</script>
