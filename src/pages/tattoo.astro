---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTattooInfo } from '../lib/sanity';
import { CARD_WIDTH, sizedImage } from '../lib/image-url';

const info = await getTattooInfo();
---
<BaseLayout title="Tattoo">
  <section class="page">
    <h1 data-intro>Tattoo</h1>
    <div data-intro set:html={info.body} />
    {info.images.length > 0 && (
      <div class="gallery" data-reveal-stagger>
        {info.images.map((src) => <img src={sizedImage(src, CARD_WIDTH)} alt="" data-reveal />)}
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .page {
    padding: 3rem 2rem;
    max-width: 60ch;
    margin: 0 auto;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }
  .gallery img {
    width: 100%;
  }
</style>
