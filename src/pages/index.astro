---
import BaseLayout from '../layouts/BaseLayout.astro';
import RuptureRule from '../components/RuptureRule.astro';
import BrandField from '../components/BrandField.astro';
import DataEgg from '../components/DataEgg.astro';
import { getAllArtworks, getHomePage } from '../lib/sanity';
import { pad2, toRoman } from '../lib/numerals';

const { heroList, heroFootnote } = await getHomePage();
const middle = Math.floor(heroList.length / 2);
// The two roads under the hero: see everything, or buy a piece.
const artworks = await getAllArtworks();
const roads = [
  { href: '/portfolio', word: 'PORTFOLIO', count: artworks.length, note: 'Works' },
  {
    href: '/collect',
    word: 'COLLECT',
    count: artworks.filter((a) => a.originalStatus === 'available').length,
    note: 'Originals available',
  },
];
---
<BaseLayout title="Home" backdrop="field-2">
  <div data-motion-page="home">
    <section class="hero" data-hero>
      <p class="hero-footnote" data-hero-intro>{heroFootnote}</p>
      <span class="hero-hairline" aria-hidden="true"></span>
      <h1 class="hero-list" data-hero-list>
        <span class="visually-hidden">GLUK — </span>
        {heroList.map((word, i) => (
          <span class="hero-line">
            <span class="hero-numeral mono" data-hero-intro>{toRoman(i + 1)}</span>
            <span class="hero-mask">
              <span class="hero-word" data-hero-word>
                <span class="visually-hidden">{word.toUpperCase()}</span>
                <span aria-hidden="true" data-hero-glyphs>{word.toUpperCase()}</span>
              </span>
            </span>
            {i === middle && (
              <span class="hero-rule" data-hero-rule>
                <RuptureRule weight="base" />
              </span>
            )}
          </span>
        ))}
      </h1>
      <div class="hero-egg"><DataEgg /></div>
    </section>

    <section class="roads" aria-label="Portfolio and collect">
      <BrandField kind="veil" class="roads-field" />
      <RuptureRule weight="base" class="roads-rule" />
      <ul class="roads-list">
        {roads.map((road, i) => (
          <li data-reveal>
            <a class="road" href={road.href}>
              <span class="mono dim">{toRoman(i + 1)}</span>
              <span class="road-word">{road.word}</span>
              <span class="label"><span class="dim">{pad2(road.count)}</span> {road.note}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>

<script>
  import { motion } from '../motion/runtime';
  import { setupHomeHero } from '../motion/home-hero';

  motion.registerPage('home', setupHomeHero);
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(8rem, 14rem) 1px 1fr;
    column-gap: clamp(1.5rem, 3vw, 3rem);
    align-items: start;
    align-content: start;
    min-height: 100svh;
    padding: calc(var(--nav-height) + 6vh) var(--gutter) 8rem;
    overflow-x: clip; /* the rupture rule bleeds off the right edge, not into a scrollbar */
  }
  .hero-footnote {
    margin: 0.4rem 0 0;
    font-size: var(--text-label);
    line-height: 1.6;
    opacity: 0.8;
  }
  .hero-hairline {
    align-self: stretch;
    background: var(--color-hairline);
    max-height: 70vh;
  }
  .hero-list {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 125%;
    font-size: clamp(min(3rem, 13.3vw), 1rem + 7.5vw, 9rem); /* CÓDIGO fits 320px */
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .hero-line {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 1.2rem;
  }
  .hero-numeral {
    padding-top: 0.6em;
    font-family: var(--font-body);
    font-weight: 400;
    font-stretch: 100%;
    opacity: 0.55;
    min-width: 2.2rem;
  }
  .hero-mask {
    display: block;
    overflow: hidden;
    padding-bottom: 0.04em;
  }
  .hero-word {
    display: block;
    white-space: pre;
  }
  /* Letter boxes built by src/motion/home-hero.ts (hence :global): each box
     takes its letter's width and overlays a code glyph centred on it. */
  .hero-word :global(.hero-ch) {
    position: relative;
    display: inline-block;
  }
  .hero-word :global(.hero-ch-letter) {
    display: inline-block;
  }
  .hero-word :global(.hero-ch-glyph) {
    position: absolute;
    inset: 0;
    text-align: center;
    opacity: 0;
    pointer-events: none;
  }
  .hero-rule {
    position: absolute;
    left: -3%;
    right: -12%;
    top: 58%;
  }
  .hero-egg {
    position: absolute;
    right: var(--gutter);
    bottom: 2.4rem;
  }
  .roads {
    position: relative;
    padding: var(--section-space) var(--gutter);
    isolation: isolate;
    overflow-x: clip; /* the rupture rule bleeds off the edges, not into a scrollbar */
  }
  /* The veil field under a 40% dark wash (was the veil image). */
  .roads :global(.roads-field) {
    z-index: -2;
  }
  .roads::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--veil-wash);
  }
  .roads :global(.roads-rule) {
    margin: 0 -8% clamp(3rem, 6vw, 6rem) -3%;
  }
  .roads-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .roads-list li + li {
    border-left: var(--rule-hair) solid var(--color-hairline);
    padding-left: clamp(1.5rem, 4vw, 4rem);
  }
  .road {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    padding: 1rem 0 2rem;
    text-decoration: none;
    transition: opacity 0.4s var(--ease-out);
  }
  .road-word {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 125%;
    font-size: clamp(2.4rem, 1rem + 4.2vw, 6.2rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
  }
  /* Hovering one road dims the other. */
  .roads-list:hover .road:not(:hover) {
    opacity: 0.4;
  }
  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
      row-gap: 2rem;
    }
    .hero-hairline { display: none; }
    .hero-egg { left: var(--gutter); }
    .roads-list { grid-template-columns: 1fr; }
    .roads-list li + li {
      border-left: 0;
      border-top: var(--rule-hair) solid var(--color-hairline);
      padding: 2rem 0 0;
      margin-top: 1rem;
    }
    .road-word { font-size: min(12vw, 4rem); }
  }
</style>
