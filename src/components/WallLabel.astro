---
import NumberedIndex, { type IndexItem } from './NumberedIndex.astro';
import PrintBlock from './PrintBlock.astro';
import RuptureRule from './RuptureRule.astro';
import { mediumLabel, type Artwork } from '../lib/sanity';
import { inquiryHref, offersPrints } from '../lib/collect';

interface Props {
  artwork: Artwork;
  heading: string;
  siblings: IndexItem[];
}

const { artwork, heading, siblings } = Astro.props;
const details = [artwork.year, artwork.dimensions].filter(Boolean).join(' · ');
const inquire = inquiryHref('original', artwork.title);
// Available → Inquire button; sold → "Sold"; auction → link to the lot;
// not for sale → no Original block.
const showOriginal = artwork.originalStatus !== 'notForSale';
---
<aside class="wall-label">
  <p class="mono dim" data-intro>{heading}</p>
  <h1 class="title" data-intro>{artwork.title}</h1>
  <RuptureRule weight="thin" class="wall-rule" />
  <p class="wall-medium" data-intro>
    {artwork.materials ?? mediumLabel(artwork.medium)}
    {details && <><br /><span class="dim">{details}</span></>}
  </p>
  {artwork.description && <p class="wall-description" data-intro>{artwork.description}</p>}
  {(showOriginal || artwork.printOffers.length > 0) && <hr class="hairline" />}
  {showOriginal && (
    <div class="wall-block" data-intro>
      <p class="label dim">Original</p>
      {artwork.originalStatus === 'available' ? (
        <>
          <p class="original-status">Available</p>
          <p class="original-meta dim">Price on request</p>
          <a class="button" href={inquire}>Inquire about the original</a>
        </>
      ) : artwork.originalStatus === 'auction' && artwork.auctionUrl ? (
        <>
          <p class="original-status">At auction</p>
          <a class="button" href={artwork.auctionUrl} rel="noopener">View lot</a>
        </>
      ) : (
        <p class="original-status">Sold</p>
      )}
    </div>
  )}
  {showOriginal && artwork.printOffers.length > 0 && <hr class="hairline" />}
  {artwork.printOffers.length > 0 && (
    <PrintBlock slug={artwork.slug} title={artwork.title} offers={artwork.printOffers} image={artwork.images[0]} />
  )}
  {/* No print sizes priced yet: prints of a collectable piece are by inquiry, matching /collect. */}
  {artwork.printOffers.length === 0 && showOriginal && offersPrints(artwork) && (
    <div class="wall-block" data-intro>
      <p class="label dim">Prints</p>
      <a class="button" href={inquiryHref('print', artwork.title)}>Inquire</a>
    </div>
  )}
  {siblings.length > 1 && (
    <>
      <hr class="hairline" />
      <NumberedIndex items={siblings} class="wall-series" />
    </>
  )}
</aside>

<style>
  .wall-label {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }
  .wall-label .title {
    margin-top: -0.4rem;
  }
  :global(.wall-rule) {
    width: 9rem !important;
  }
  .wall-medium,
  .wall-description {
    margin: 0;
  }
  .wall-block .label {
    margin: 0 0 0.8rem;
  }
  .original-status {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 125%;
    font-size: var(--text-title);
    line-height: 0.95;
    letter-spacing: -0.02em;
    margin: 0 0 0.6rem;
  }
  .original-meta {
    margin: 0 0 1.2rem;
  }
</style>
