PUBLIC_SANITY_PROJECT_ID=your-project-id
PUBLIC_SANITY_DATASET=production

# Editor-level Sanity token, used only by the Node seed scripts (scripts/seed-*.mjs).
# SANITY_WRITE_TOKEN=

# Folder of tattoo photos to upload, used only by scripts/seed-tattoo-images.mjs.
# TATTOO_DIR=

# Enables live weather/sea data in the home-page data egg (spec §8). Leave unset
# until a commercial Open-Meteo plan is chosen.
# PUBLIC_LIVE_WEATHER=on

# Netlify production context only (set in netlify.toml, not here): fails the build
# instead of publishing an empty Journal when the Substack feed is unreachable.
# JOURNAL_FEED_REQUIRED=true
